#!/usr/bin/env python3
"""Посты владельцу в Telegram: команды кладут посты в очередь плагина, а он держит в Telegram ровно один неразобранный
пост — следующий уходит, когда этот закрыт кнопкой ❤️ или 👎 или когда на него ответили реплаем (докрутка).

    tg-posts drafts <файл.md> [--only 3,5] [--image N=<путь> …]   варианты постов из «## N. Название» в очередь; реплай
                                                                   владельца на пост (докрутка) придёт этой сессии, следующий
                                                                   пост уходит сразу; новая версия — та же команда с --only N
                                                                   — встанет в очереди первой, за открытым
    tg-posts deck [--count 10] [--url <адрес колоды>]             карточки колоды в очередь; ❤️ 👎 и реплаи плагин
                                                                   сам отдаёт серверу колоды, без хода сессии
    tg-posts deck --id <id> [<id> …]                              докрученные колодой карточки (её сервер зовёт сам) —
                                                                   в очереди первыми, сразу за открытой
    tg-posts status                                               что открыто, сколько в очереди и в докрутке
    tg-posts clear                                                сбросить очередь и открытый пост
Только stdlib: сессия зовёт его как есть, без кода хаба на пути."""
import argparse
import hashlib
import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request
import uuid

EXT = "tg-posts"   # имя расширения в факте: по нему процесс плагина узнаёт свои нажатия и реплаи
_last = 0


def inbox(state):
    return os.path.join(state, EXT, "inbox")


def put(state, cmd):
    """Команда плагину в его ящик (атомарно, порядок — по имени): посты и сброс очереди."""
    global _last
    d = inbox(state)
    os.makedirs(d, exist_ok=True)
    _last = max(time.time_ns(), _last + 1)
    name = f"{_last:020d}-{os.getpid()}-{uuid.uuid4().hex[:6]}"
    tmp = os.path.join(d, "." + name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cmd, f, ensure_ascii=False)
    os.replace(tmp, os.path.join(d, name + ".json"))


def enqueue(state, items):
    put(state, {"op": "post", "items": items})
    return "" if os.path.isfile(os.path.join(state, EXT, "state.json")) else \
        " (состояния плагина нет — процесс плагина не запущен? без него посты не уйдут)"


def fingerprint(path):
    """Отпечаток картинки: тот же путь с другим содержимым — другая версия поста."""
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except OSError:
        return None


def verdicts(state, items):
    """['new' | 'same' | 'revised'] по каждому посту — как решит плагин (его enqueue), по его state.json, только чтение.
    Разобрано плагином не всё, что лежит в ящике: ответ «по состоянию на сейчас»; ставим в очередь всё равно."""
    try:
        with open(os.path.join(state, EXT, "state.json"), encoding="utf-8") as f:
            st = json.load(f)
    except (OSError, ValueError):
        return ["new"] * len(items)
    have = {k: p for k, p in (st.get("revising") or {}).items() if isinstance(p, dict)}   # докручиваемые — их новая версия тоже «та же»
    have.update({p["key"]: p for p in (st.get("posts") or []) if isinstance(p, dict) and "key" in p})
    o = st.get("open")
    if isinstance(o, dict) and "key" in o:
        have[o["key"]] = o
    out = []
    for it in items:
        old = have.get(it["key"])
        if old is None:
            shown = it.get("ref") in (st.get("seen") or {}) or (st.get("sent") or {}).get(it.get("ref"), {}).get("kind") == "deck"
            out.append("same" if it["kind"] == "deck" and not it.get("fresh") and shown else "new")   # показанную карточку плагин не шлёт второй раз
        elif it["kind"] == "deck":
            out.append("revised" if it.get("fresh") and it["key"] in (st.get("revising") or {}) else "same")
        else:
            path, img = (it.get("path"), it.get("img")) if it.get("path") else (old.get("path"), old.get("img"))
            same = it["text"] == old.get("text") and path == old.get("path") and img == old.get("img")
            out.append("same" if same else "revised")
    return out


def drafts(text):
    """[(N, название, тело)] из «## N. Название» — тело до следующего «## » без хвостовых «---»."""
    out = []
    parts = re.split(r"^##[ \t]+(\d+)[.)][ \t]*(.*)$", text, flags=re.M)
    for i in range(1, len(parts) - 2, 3):
        body = re.sub(r"(\s*\n\s*-{3,}\s*)+$", "", parts[i + 2]).strip()
        out.append((int(parts[i]), parts[i + 1].strip(), body))
    return out


def images(pairs):
    got = {}
    for p in pairs or []:
        n, sep, path = p.partition("=")
        if not sep or not n.strip().isdigit():
            sys.exit(f"--image ждёт N=<путь>, а не «{p}»")
        path = os.path.abspath(os.path.expanduser(path.strip()))
        if not os.path.isfile(path):
            sys.exit(f"нет файла {path}")
        got[int(n)] = path
    return got


def cmd_drafts(a, state):
    path = os.path.abspath(a.file)
    with open(path, encoding="utf-8") as f:
        posts = drafts(f.read())
    only = {int(x) for x in a.only.split(",")} if a.only else None
    pics = images(a.image)
    session = a.session or os.environ.get("HUB_SESSION")
    if not session:
        sys.exit("нужна сессия: --session <имя> (в сессии хаба — сама)")
    items = []
    for n, title, body in posts:
        if only and n not in only:
            continue
        item = {"kind": "drafts", "key": f"{path}#{n}", "text": f"{n}. {title}\n\n{body}".strip(),
                "ref": f"{os.path.basename(path)} #{n} {title}", "session": session, "file": path, "n": n, "title": title}
        if n in pics:
            item["path"], item["img"] = pics[n], fingerprint(pics[n])
        items.append(item)
    verdict = verdicts(state, items)
    warn = enqueue(state, items)
    same = [it["n"] for it, v in zip(items, verdict) if v == "same"]
    name = os.path.basename(path)
    if items and len(same) == len(items):
        print(f"без изменений — {'пост' if len(same) == 1 else 'посты'} {', '.join(map(str, same))} из {name} уже открыт или "
              f"в очереди с тем же текстом и картинкой, второй раз не отправлю. Новая версия — другой текст или другая "
              f"картинка (файл с новым содержимым подойдёт){warn}")
        return
    note = f"; без изменений (уже есть): {', '.join(map(str, same))}" if same else ""
    print(f"в очередь: {len(items) - len(same)} пост(ов) из {name}{note}{warn}; в Telegram идёт по одному — следующий после "
          "❤️ или 👎. Реплай владельца (докрутка) придёт сюда с пометкой поста; после реплая следующий пост уже ушёл — "
          "пришли новую версию той же командой с --only N: она встанет в очереди следующей")


def deck_url(a, state):
    if a.url:
        return a.url.rstrip("/")
    cfg = os.environ.get("HUB_CONFIG") or os.path.expanduser("~/.config/hub-core/hub.json")
    try:
        with open(cfg, encoding="utf-8") as f:
            ext = json.load(f).get("extensions") or {}
    except (OSError, ValueError):
        ext = {}
    for k, v in ext.items():
        if (k == EXT or k.endswith(":" + EXT)) and isinstance(v, dict) and v.get("deck"):
            return str(v["deck"]).rstrip("/")
    return "http://localhost:7777"


def fetch(url):
    with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(url, timeout=10) as r:   # колода — localhost
        return json.load(r)


def card_post(c, pic=None):
    text = "\n\n".join(x.strip() for x in (c.get("caption"), c.get("caption_ru")) if x and x.strip())
    data = {"kind": "deck", "key": c["id"], "text": text or c["id"], "ref": c["id"]}
    if pic:
        data["path"] = pic
    return data


def thumb(url, c, state, fresh=False):
    """Превью карточки — с сервера колоды в папку плагина (бот грузит файл с диска); не вышло — пост без картинки.
    fresh — карточка докручена: картинка могла смениться под тем же именем, кэш не берём."""
    name = c.get("thumb")
    if not name:
        return None
    path = os.path.join(state, EXT, "media", re.sub(r"[^\w.-]", "_", os.path.basename(name)))
    if os.path.isfile(path) and not fresh:
        return path
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(
                f"{url}/media/{urllib.parse.quote(name)}", timeout=20) as r:
            raw = r.read()
    except OSError as e:
        print(f"{c['id']}: превью не скачалось ({e}) — без картинки", file=sys.stderr)
        return None
    with open(path + ".tmp", "wb") as f:
        f.write(raw)
    os.replace(path + ".tmp", path)
    return path


def cmd_deck(a, state):
    url = deck_url(a, state)
    try:
        got = fetch(url + "/api/deck")
    except (OSError, ValueError) as e:
        sys.exit(f"колода {url} не отвечает: {e}")
    cards = (got.get("cards") if isinstance(got, dict) else got) or []   # там только неоценённые
    if a.id:   # докрученные колодой: эти карточки, не первые N; в очереди — первыми за открытой
        by_id = {c["id"]: c for c in cards if c.get("id")}
        todo = [by_id[i] for i in dict.fromkeys(a.id) if i in by_id]
        missing = [i for i in dict.fromkeys(a.id) if i not in by_id]
        if not todo:
            sys.exit(f"в колоде {url} нет неоценённых карточек: {', '.join(missing)}")
        warn = enqueue(state, [{**card_post(c, thumb(url, c, state, fresh=True)), "fresh": True} for c in todo])
        print(f"в очередь первыми: {len(todo)} карточек колоды {url}"
              + (f"; нет среди неоценённых: {', '.join(missing)}" if missing else "") + warn)
        return
    todo = [c for c in cards if c.get("id")][: a.count]
    warn = enqueue(state, [card_post(c, thumb(url, c, state)) for c in todo])
    print(f"в очередь: {len(todo)} из {len(cards)} карточек колоды {url}{warn}; в Telegram идёт по одному — следующая после "
          "❤️ или 👎, их и реплаи плагин отдаст колоде сам")


def cmd_status(a, state):
    try:
        with open(os.path.join(state, EXT, "state.json"), encoding="utf-8") as f:
            st = json.load(f)
    except (OSError, ValueError):
        sys.exit("состояния плагина нет: процесс плагина не запущен или ещё ничего не получал")
    o, posts = st.get("open"), st.get("posts") or []
    new = sum(n.endswith(".json") for n in os.listdir(inbox(state))) if os.path.isdir(inbox(state)) else 0
    print("открыт в Telegram: " + (f"{o['ref']} (с {time.strftime('%d.%m %H:%M', time.localtime(o['at']))})" if o else "ничего"))
    print(f"в очереди: {len(posts)}" + "".join(f"\n  {p['ref']}" for p in posts[:10]) + ("\n  …" if len(posts) > 10 else ""))
    if new:
        print(f"ещё не разобрано плагином: {new} команд(ы)")
    rev = st.get("revising") or {}
    if rev:
        print(f"в докрутке: {len(rev)}" + "".join(f"\n  {p['ref']}" for p in list(rev.values())[:10]))
    if st.get("jobs"):
        print(f"оценок ждёт колоду: {len(st['jobs'])}")


def cmd_clear(a, state):
    put(state, {"op": "clear"})
    print("очередь и открытый пост сброшены (сообщения, уже висящие в Telegram, остаются)")


def main(argv=None):
    p = argparse.ArgumentParser(prog="tg-posts")
    sub = p.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("drafts")
    d.add_argument("file")
    d.add_argument("--only")
    d.add_argument("--image", action="append")
    d.add_argument("--session")
    k = sub.add_parser("deck")
    k.add_argument("--count", type=int, default=10)
    k.add_argument("--url")
    k.add_argument("--id", nargs="+", action="extend")
    sub.add_parser("status")
    sub.add_parser("clear")
    a = p.parse_args(argv)
    state = os.environ.get("HUB_STATE_DIR")
    if not state:
        sys.exit("нужен HUB_STATE_DIR (в сессии хаба он есть)")
    {"drafts": cmd_drafts, "deck": cmd_deck, "status": cmd_status, "clear": cmd_clear}[a.cmd](a, state)


if __name__ == "__main__":
    main()
