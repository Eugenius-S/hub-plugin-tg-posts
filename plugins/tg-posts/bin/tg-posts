#!/usr/bin/env python3
"""Posts to the owner in Telegram: the commands put posts into the plugin's queue, and it keeps exactly one unreviewed
post in Telegram - the next one goes out when this one is closed with the ❤️ or 👎 button or when it got a reply
(revision).

    tg-posts drafts <file.md> [--only 3,5] [--image N=<path> ...]   draft posts from "## N. Title" into the queue; the owner's
                                                                    reply to a post (revision) comes to this session, the next
                                                                    post goes out at once; a new version - the same command
                                                                    with --only N - stands first in the queue, after the open one
    tg-posts deck [--count 10] [--url <deck address>]               deck cards into the queue; the plugin passes ❤️ 👎 and
                                                                    replies to the deck server itself, without a session turn
    tg-posts deck --id <id> [<id> ...]                              cards revised by the deck (its server calls this itself) -
                                                                    first in the queue, right after the open one
    tg-posts status                                                 what is open, how many are in the queue and in revision
    tg-posts clear                                                  reset the queue and the open post
    tg-posts again [<ref>]                                          the open post - to Telegram once more, as a new message at the bottom (to remind about it); the same post, the queue does not move
    tg-posts close <ref>                                            close a post without a rating to the deck (it is already rated in the deck); the open one - the next goes out at once
Stdlib only: a session calls it as is, without hub code on the path."""
import argparse
import hashlib
import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request
import uuid

EXT = "tg-posts"   # the extension name in the fact: the plugin process recognizes its presses and replies by it
_last = 0


def inbox(state):
    return os.path.join(state, EXT, "inbox")


def put(state, cmd):
    """A command to the plugin in its inbox (atomic, order by name): posts and queue reset."""
    global _last
    d = inbox(state)
    os.makedirs(d, exist_ok=True)
    _last = max(time.time_ns(), _last + 1)
    name = f"{_last:020d}-{os.getpid()}-{uuid.uuid4().hex[:6]}"
    tmp = os.path.join(d, "." + name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(cmd, f, ensure_ascii=False)
    os.replace(tmp, os.path.join(d, name + ".json"))


def enqueue(state, items):
    put(state, {"op": "post", "items": items})
    return "" if os.path.isfile(os.path.join(state, EXT, "state.json")) else \
        " (no plugin state - is the plugin process not running? posts will not go out without it)"


def fingerprint(path):
    """Fingerprint of a picture: the same path with other content is another version of the post."""
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except OSError:
        return None


def verdicts(state, items):
    """['new' | 'same' | 'revised'] for each post - as the plugin will decide (its enqueue), from its state.json, read only.
    The plugin has not parsed everything that lies in the inbox: the answer is "as of now"; we enqueue anyway."""
    try:
        with open(os.path.join(state, EXT, "state.json"), encoding="utf-8") as f:
            st = json.load(f)
    except (OSError, ValueError):
        return ["new"] * len(items)
    have = {k: p for k, p in (st.get("revising") or {}).items() if isinstance(p, dict)}   # those in revision - their new version is also "the same"
    have.update({p["key"]: p for p in (st.get("posts") or []) if isinstance(p, dict) and "key" in p})
    o = st.get("open")
    if isinstance(o, dict) and "key" in o:
        have[o["key"]] = o
    out = []
    for it in items:
        old = have.get(it["key"])
        if old is None:
            shown = it.get("ref") in (st.get("seen") or {}) or (st.get("sent") or {}).get(it.get("ref"), {}).get("kind") == "deck"
            out.append("same" if it["kind"] == "deck" and not it.get("fresh") and shown else "new")   # the plugin does not send a shown card a second time
        elif it["kind"] == "deck":
            out.append("revised" if it.get("fresh") and old is not o else "same")   # it does not touch the open one; a waiting one and one in revision come back first
        else:
            path, img = (it.get("path"), it.get("img")) if it.get("path") else (old.get("path"), old.get("img"))
            same = it["text"] == old.get("text") and path == old.get("path") and img == old.get("img")
            out.append("same" if same else "revised")
    return out


def drafts(text):
    """[(N, title, body)] from "## N. Title" - the body up to the next "## " without trailing "---"."""
    out = []
    parts = re.split(r"^##[ \t]+(\d+)[.)][ \t]*(.*)$", text, flags=re.M)
    for i in range(1, len(parts) - 2, 3):
        body = re.sub(r"(\s*\n\s*-{3,}\s*)+$", "", parts[i + 2]).strip()
        out.append((int(parts[i]), parts[i + 1].strip(), body))
    return out


def images(pairs):
    got = {}
    for p in pairs or []:
        n, sep, path = p.partition("=")
        if not sep or not n.strip().isdigit():
            sys.exit(f"--image expects N=<path>, not \"{p}\"")
        path = os.path.abspath(os.path.expanduser(path.strip()))
        if not os.path.isfile(path):
            sys.exit(f"no such file: {path}")
        got[int(n)] = path
    return got


def cmd_drafts(a, state):
    path = os.path.abspath(a.file)
    with open(path, encoding="utf-8") as f:
        posts = drafts(f.read())
    only = {int(x) for x in a.only.split(",")} if a.only else None
    pics = images(a.image)
    session = a.session or os.environ.get("HUB_SESSION")
    if not session:
        sys.exit("a session is required: --session <name> (inside a hub session it is set by itself)")
    items = []
    for n, title, body in posts:
        if only and n not in only:
            continue
        item = {"kind": "drafts", "key": f"{path}#{n}", "text": f"{n}. {title}\n\n{body}".strip(),
                "ref": f"{os.path.basename(path)} #{n} {title}", "session": session, "file": path, "n": n, "title": title}
        if n in pics:
            item["path"], item["img"] = pics[n], fingerprint(pics[n])
        items.append(item)
    verdict = verdicts(state, items)
    warn = enqueue(state, items)
    same = [it["n"] for it, v in zip(items, verdict) if v == "same"]
    name = os.path.basename(path)
    if items and len(same) == len(items):
        print(f"no changes - {'post' if len(same) == 1 else 'posts'} {', '.join(map(str, same))} from {name} "
              f"{'is' if len(same) == 1 else 'are'} already open or in the queue with the same text and picture, "
              f"I will not send {'it' if len(same) == 1 else 'them'} a second time. A new version is another text or "
              f"another picture (a file with new content will do){warn}")
        return
    note = f"; no changes (already there): {', '.join(map(str, same))}" if same else ""
    print(f"queued: {len(items) - len(same)} post(s) from {name}{note}{warn}; they go to Telegram one at a time - the next one after "
          "❤️ or 👎. The owner's reply (revision) comes here with a note about the post; after a reply the next post has already gone out - "
          "send a new version with the same command and --only N: it will stand next in the queue")


def deck_url(a, state):
    if a.url:
        return a.url.rstrip("/")
    cfg = os.environ.get("HUB_CONFIG") or os.path.expanduser("~/.config/hub-core/hub.json")
    try:
        with open(cfg, encoding="utf-8") as f:
            ext = json.load(f).get("extensions") or {}
    except (OSError, ValueError):
        ext = {}
    for k, v in ext.items():
        if (k == EXT or k.endswith(":" + EXT)) and isinstance(v, dict) and v.get("deck"):
            return str(v["deck"]).rstrip("/")
    return "http://localhost:7777"


def fetch(url):
    with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(url, timeout=10) as r:   # the deck is localhost
        return json.load(r)


def card_post(c, pic=None):
    text = "\n\n".join(x.strip() for x in (c.get("caption"), c.get("caption_ru")) if x and x.strip())
    data = {"kind": "deck", "key": c["id"], "text": text or c["id"], "ref": c["id"]}
    if pic:
        data["path"] = pic
    return data


VIDEO_MAX = 50 * 1024 * 1024   # the Bot API upload limit: larger - a picture goes to Telegram


def download(url, name, state, fresh, limit=None):
    """A card file from the deck server into the plugin folder (the bot uploads the file from disk); None - failed or larger than limit."""
    path = os.path.join(state, EXT, "media", re.sub(r"[^\w.-]", "_", os.path.basename(name)))
    if os.path.isfile(path) and not fresh:
        return path
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(
                f"{url}/media/{urllib.parse.quote(name)}", timeout=60 if limit else 20) as r:
            raw = r.read(limit + 1 if limit else -1)
    except OSError as e:
        print(f"{name}: download failed ({e})", file=sys.stderr)
        return None
    if limit and len(raw) > limit:
        print(f"{name}: larger than {limit} bytes - will go as a picture", file=sys.stderr)
        return None
    with open(path + ".tmp", "wb") as f:
        f.write(raw)
    os.replace(path + ".tmp", path)
    return path


def thumb(url, c, state, fresh=False):
    """A card file for Telegram: a video (local_video - the file name on the deck server), otherwise the preview; failed - a post
    without a picture. fresh - the card was revised: the file may have changed under the same name, the cache is not used."""
    if c.get("local_video"):
        got = download(url, c["local_video"], state, fresh, VIDEO_MAX)
        if got:
            return got
    return download(url, c["thumb"], state, fresh) if c.get("thumb") else None


def cmd_deck(a, state):
    url = deck_url(a, state)
    try:
        got = fetch(url + "/api/deck")
    except (OSError, ValueError) as e:
        sys.exit(f"the deck {url} does not answer: {e}")
    cards = (got.get("cards") if isinstance(got, dict) else got) or []   # it holds unrated ones only
    if a.id:   # revised by the deck: these cards, not the first N; in the queue - first after the open one
        by_id = {c["id"]: c for c in cards if c.get("id")}
        todo = [by_id[i] for i in dict.fromkeys(a.id) if i in by_id]
        missing = [i for i in dict.fromkeys(a.id) if i not in by_id]
        if not todo:
            sys.exit(f"the deck {url} has no unrated cards: {', '.join(missing)}")
        warn = enqueue(state, [{**card_post(c, thumb(url, c, state, fresh=True)), "fresh": True} for c in todo])
        print(f"queued first: {len(todo)} cards of the deck {url}"
              + (f"; not among the unrated: {', '.join(missing)}" if missing else "") + warn)
        return
    todo = [c for c in cards if c.get("id")][: a.count]
    warn = enqueue(state, [card_post(c, thumb(url, c, state)) for c in todo])
    print(f"queued: {len(todo)} of {len(cards)} cards of the deck {url}{warn}; they go to Telegram one at a time - the next one after "
          "❤️ or 👎, the plugin passes those and the replies to the deck itself")


def cmd_status(a, state):
    try:
        with open(os.path.join(state, EXT, "state.json"), encoding="utf-8") as f:
            st = json.load(f)
    except (OSError, ValueError):
        sys.exit("no plugin state: the plugin process is not running or has not received anything yet")
    o, posts = st.get("open"), st.get("posts") or []
    new = sum(n.endswith(".json") for n in os.listdir(inbox(state))) if os.path.isdir(inbox(state)) else 0
    print("open in Telegram: " + (f"{o['ref']} (since {time.strftime('%d.%m %H:%M', time.localtime(o['at']))})" if o else "nothing"))
    print(f"in the queue: {len(posts)}" + "".join(f"\n  {p['ref']}" for p in posts[:10]) + ("\n  …" if len(posts) > 10 else ""))
    if new:
        print(f"not yet parsed by the plugin: {new} command(s)")
    rev = st.get("revising") or {}
    if rev:
        print(f"in revision: {len(rev)}" + "".join(f"\n  {p['ref']}" for p in list(rev.values())[:10]))
    if st.get("jobs"):
        print(f"ratings waiting for the deck: {len(st['jobs'])}")


def cmd_close(a, state):
    put(state, {"op": "close", "ref": a.ref})
    print(f"{a.ref}: closed in the plugin without a rating to the deck; if it was open - the next one goes to the owner")


def cmd_again(a, state):
    """The plugin state is read only (like status): no open post or the ref is not open - nothing goes into the inbox."""
    try:
        with open(os.path.join(state, EXT, "state.json"), encoding="utf-8") as f:
            o = json.load(f).get("open")
    except (OSError, ValueError):
        sys.exit("no plugin state: the plugin process is not running or has not received anything yet")
    if not isinstance(o, dict):
        print("no open post - nothing to send")
        return
    if a.ref and a.ref not in (o.get("ref"), o.get("key")):
        print(f"{a.ref} is not open (open: {o.get('ref')}) - nothing to send")
        return
    put(state, {"op": "again", "ref": o["ref"]})
    print(f"{o['ref']}: sending it once more as a new message; it is the same post - buttons and replies on the old and the new message belong to it, the queue does not move")


def cmd_clear(a, state):
    put(state, {"op": "clear"})
    print("the queue and the open post are reset (messages already hanging in Telegram stay)")


def main(argv=None):
    p = argparse.ArgumentParser(prog="tg-posts")
    sub = p.add_subparsers(dest="cmd", required=True)
    d = sub.add_parser("drafts")
    d.add_argument("file")
    d.add_argument("--only")
    d.add_argument("--image", action="append")
    d.add_argument("--session")
    k = sub.add_parser("deck")
    k.add_argument("--count", type=int, default=10)
    k.add_argument("--url")
    k.add_argument("--id", nargs="+", action="extend")
    c = sub.add_parser("close")
    c.add_argument("ref")
    g = sub.add_parser("again")
    g.add_argument("ref", nargs="?")
    sub.add_parser("status")
    sub.add_parser("clear")
    a = p.parse_args(argv)
    state = os.environ.get("HUB_STATE_DIR")
    if not state:
        sys.exit("HUB_STATE_DIR is required (a hub session has it)")
    {"drafts": cmd_drafts, "deck": cmd_deck, "status": cmd_status, "clear": cmd_clear, "close": cmd_close, "again": cmd_again}[a.cmd](a, state)


if __name__ == "__main__":
    main()
